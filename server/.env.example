# Required: your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model and reasoning effort (low | medium | high | xhigh | max)
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high

# Optional: let the assistant search the live web, restricted to Ansible / Red Hat domains (true/false)
ENABLE_WEB_SEARCH=true

# Optional: let the assistant run ansible-lint / syntax-check / ansible-doc on this server (true/false)
ENABLE_ANSIBLE_TOOLS=true

# Optional Whisper fallback for speech input (used when the browser has no Web Speech API).
# Any OpenAI-compatible /audio/transcriptions endpoint works: a local whisper.cpp / faster-whisper server, or a hosted one.
# WHISPER_URL=http://localhost:9000/v1/audio/transcriptions
# WHISPER_API_KEY=
# WHISPER_MODEL=whisper-1
