  "summary": "Shows strftime's utc argument (2.13+) to format the current time in UTC instead of local time.",
  "questions": [
    "How do I get the current time in UTC with strftime?"
  ],
  "answer_card": {
    "title": "strftime in UTC",
    "answer_md": "```jinja\n{{ '%H:%M:%S' | strftime }}            # local time\n{{ '%H:%M:%S' | strftime(utc=True) }}  # UTC\n```",
